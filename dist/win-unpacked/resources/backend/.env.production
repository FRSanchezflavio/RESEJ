# =========================================================
# CONFIGURACIÓN DE PRODUCCIÓN - Sistema RESEJ Policía
# =========================================================
# Este archivo contiene la configuración para producción
# Copiar este archivo a .env y ajustar según necesidad
# =========================================================

# ==================== SERVIDOR ====================
PORT=3001
NODE_ENV=production
HOST=0.0.0.0

# ==================== BASE DE DATOS ====================
# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resej_db
DB_USER=resej_user
DB_PASSWORD=CAMBIAR_CONTRASEÑA_SEGURA_AQUI

# ==================== SEGURIDAD JWT ====================
# ⚠️ CRÍTICO: Cambiar estas claves en cada instalación
# Generar claves seguras con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_JWT_SECRET_AQUI_CON_CLAVE_ALEATORIA_LARGA
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=CAMBIAR_REFRESH_TOKEN_SECRET_AQUI_CON_CLAVE_ALEATORIA_LARGA
REFRESH_TOKEN_EXPIRES_IN=7d

# ==================== SEGURIDAD SESIÓN ====================
SESSION_SECRET=CAMBIAR_SESSION_SECRET_AQUI_CON_CLAVE_ALEATORIA_LARGA

# ==================== ARCHIVOS ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ==================== SEGURIDAD ====================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== CORS ====================
# Agregar las URLs permitidas separadas por coma
# Ejemplos:
# - Aplicación de escritorio: http://localhost:3001
# - Acceso en red local: http://192.168.1.X:3001
# - Múltiples IPs: http://192.168.1.100:3001,http://192.168.1.101:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# ==================== EMAIL ====================
# Configuración para envío de correos (recuperación de contraseña, notificaciones)
# Gmail: Usar "Contraseña de aplicación" en https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=correo@institucion.gob
EMAIL_PASSWORD=contraseña_de_aplicacion
EMAIL_FROM="Sistema RESEJ <correo@institucion.gob>"

# ==================== FRONTEND ====================
# URL base del frontend
FRONTEND_URL=http://localhost:3001
FRONTEND_PORT=5173

# ==================== TOKENS DE ACCESO TEMPORAL ====================
# Para acceso desde dispositivos móviles
TOKEN_ACCESS_EXPIRES_IN=24h
TOKEN_ACCESS_CLEANUP_INTERVAL=86400000

# ==================== LOGS ====================
# Configuración de logs de auditoría
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=10

# ==================== BACKUP ====================
# Configuración de backups automáticos (opcional)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# =========================================================
# INSTRUCCIONES DE CONFIGURACIÓN
# =========================================================
# 
# 1. BASE DE DATOS:
#    - Crear usuario y base de datos en PostgreSQL
#    - Actualizar DB_USER, DB_PASSWORD, DB_NAME
#    - Ejecutar migraciones: npm run migrate
#
# 2. SEGURIDAD:
#    - Cambiar TODAS las claves secretas (JWT_SECRET, etc.)
#    - Usar contraseñas fuertes (mínimo 32 caracteres)
#    - Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# 3. EMAIL:
#    - Configurar cuenta de correo institucional
#    - Para Gmail: Activar verificación en 2 pasos
#    - Generar contraseña de aplicación
#
# 4. CORS:
#    - Agregar todas las URLs desde donde se accederá
#    - Para red local: agregar IPs de todas las computadoras
#
# 5. ARCHIVOS:
#    - Verificar que carpeta uploads/ tenga permisos de escritura
#    - MAX_FILE_SIZE en bytes (10MB = 10485760)
#
# 6. VERIFICACIÓN:
#    - Ejecutar: npm run verificar
#    - Revisar logs en: ./logs/
#
# =========================================================
# CHECKLIST DE SEGURIDAD
# =========================================================
# [ ] Cambiar DB_PASSWORD
# [ ] Cambiar JWT_SECRET
# [ ] Cambiar REFRESH_TOKEN_SECRET  
# [ ] Cambiar SESSION_SECRET
# [ ] Configurar EMAIL_USER y EMAIL_PASSWORD
# [ ] Actualizar ALLOWED_ORIGINS
# [ ] Verificar permisos de carpetas
# [ ] Cambiar contraseña del usuario admin
# [ ] Configurar backups automáticos
# [ ] Revisar logs de auditoría
# =========================================================
