# Archivo de ejemplo para producción. NO incluir este archivo con credenciales reales en el repo público.
# Copie este archivo a .env y reemplace los valores por los datos reales de producción.

# ------------------------------------------------------------------
# Configuración de Base de Datos (PostgreSQL)
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resej_db
DB_USER=resej_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ------------------------------------------------------------------
# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ------------------------------------------------------------------
# JWT y Seguridad
# Generar valores fuertes y únicos para producción
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_VALUE
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_STRONG_RANDOM_VALUE
SESSION_SECRET=CHANGE_ME_GENERATE_SESSION_SECRET

# ------------------------------------------------------------------
# Email (opcional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=CHANGE_ME_EMAIL_PASSWORD

# ------------------------------------------------------------------
# Otras opciones
ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
LOG_LEVEL=info

# ------------------------------------------------------------------
# Notas de seguridad:
# - No suba el archivo .env con credenciales reales a repositorios.
# - Use contraseñas largas (>16) y generadores de secretos.
# - Considere encriptar secretos o usar un vault (Azure KeyVault, AWS Secrets Manager, HashiCorp Vault).