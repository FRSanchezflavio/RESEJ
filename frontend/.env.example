# ============================================
# Configuración del Frontend - RE.SE.J
# ============================================

# API Backend URL
# Para desarrollo local (mismo equipo):
VITE_API_URL=http://localhost:3000/api

# Para acceso desde la red local (otros dispositivos):
# Reemplaza 192.168.1.23 con la IP de tu PC donde corre el backend
# VITE_API_URL=http://192.168.1.23:3000/api

# Frontend URL (para compartir enlaces)
# Para desarrollo local:
VITE_FRONTEND_URL=http://localhost:5173

# Para acceso desde la red local:
# VITE_FRONTEND_URL=http://192.168.1.23:5173

# ============================================
# Instrucciones de uso:
# ============================================
# 1. Copia este archivo a .env
# 2. Ajusta las URLs según tu configuración
# 3. Reinicia el servidor de Vite (npm run dev)
# ============================================
