import React, { useCallback, useEffect, useMemo, useState } from 'react';
import {
  Card,
  Form,
  Button,
  Row,
  Col,
  Modal,
  Alert,
  Spinner,
} from 'react-bootstrap';
import { uploadRegistro, fetchPersonas, createPersona } from '../../api/api';

const initialRegistroState = {
  fecha_carga: '',
  fecha_ingreso: '',
  ufi: '',
  numero_legajo: '',
  seccion_que_interviene: '',
  detalle_secuestro: '',
  numero_protocolo: '',
  cadena_custodia: '',
  nro_folio: '',
  nro_libro_secuestro: '',
  of_a_cargo: '',
  observaciones: '',
};

const initialPersonaState = {
  nombre: '',
  apellido: '',
  dni: '',
  telefono: '',
  email: '',
  domicilio: '',
};

export default function UploadForm() {
  const [form, setForm] = useState(initialRegistroState);
  const [files, setFiles] = useState(null);
  const [msg, setMsg] = useState('');
  const [msgType, setMsgType] = useState('danger');
  const [submitting, setSubmitting] = useState(false);

  const [personas, setPersonas] = useState([]);
  const [personasLoading, setPersonasLoading] = useState(false);
  const [personasError, setPersonasError] = useState('');
  const [selectedPersona, setSelectedPersona] = useState('');

  const [showPersonaModal, setShowPersonaModal] = useState(false);
  const [personaForm, setPersonaForm] = useState(initialPersonaState);
  const [personaSubmitting, setPersonaSubmitting] = useState(false);
  const [personaError, setPersonaError] = useState('');

  const loadPersonas = useCallback(async () => {
    setPersonasLoading(true);
    setPersonasError('');
    try {
      const response = await fetchPersonas({ limit: 100, page: 1 });
      const data =
        response?.data?.data?.personas ?? response?.data?.personas ?? [];
      const personasList = Array.isArray(data) ? data : [];
      setPersonas(personasList);

      if (
        personasList.length > 0 &&
        !personasList.some(persona => String(persona.id) === selectedPersona)
      ) {
        setSelectedPersona(String(personasList[0].id));
      }
    } catch (error) {
      console.error('Error cargando personas', error);
      setPersonasError(
        'No se pudieron cargar las personas registradas. Cree una nueva antes de continuar.'
      );
    } finally {
      setPersonasLoading(false);
    }
  }, [selectedPersona]);

  useEffect(() => {
    loadPersonas();
  }, [loadPersonas]);

  const personaOptions = useMemo(
    () =>
      personas.map(persona => ({
        value: String(persona.id),
        label:
          `${persona.nombre ?? ''} ${persona.apellido ?? ''}`.trim() ||
          `Persona ${persona.id}`,
        subtitle: persona.dni ? `DNI ${persona.dni}` : null,
      })),
    [personas]
  );

  const resetRegistroForm = () => {
    setForm(initialRegistroState);
    setFiles(null);
  };

  const handleRegistroChange = e => {
    const { name, value, type } = e.target;

    let newValue = value;
    if (type === 'date' && value) {
      if (value.includes('/')) {
        const [dia, mes, anio] = value.split('/');
        newValue = `${anio}-${mes.padStart(2, '0')}-${dia.padStart(2, '0')}`;
      }
    }

    setForm(prev => ({ ...prev, [name]: newValue }));
  };

  const handlePersonaFieldChange = e => {
    const { name, value } = e.target;
    setPersonaForm(prev => ({ ...prev, [name]: value }));
  };

  const handleSubmit = async e => {
    e.preventDefault();

    if (!selectedPersona) {
      setMsgType('danger');
      setMsg('Debes seleccionar o crear primero una persona.');
      return;
    }

    const fd = new FormData();
    const fechaIngresoISO = form.fecha_ingreso
      ? new Date(form.fecha_ingreso).toISOString().split('T')[0]
      : '';
    const fechaCargaISO = form.fecha_carga
      ? new Date(form.fecha_carga).toISOString().split('T')[0]
      : '';

    Object.entries({
      ...form,
      fecha_ingreso: fechaIngresoISO,
      fecha_carga: fechaCargaISO,
      persona_id: Number(selectedPersona),
    }).forEach(([key, value]) => {
      if (value !== undefined && value !== null && value !== '') {
        fd.append(key, value);
      }
    });

    if (files) {
      Array.from(files).forEach(file => fd.append('archivos', file));
    }

    setSubmitting(true);
    setMsg('');

    try {
      await uploadRegistro(fd);
      setMsgType('success');
      setMsg('Registro cargado correctamente.');
      resetRegistroForm();
    } catch (error) {
      console.error('Error al subir registro', error);
      const errorMsg =
        error?.response?.data?.error || error?.message || 'Error inesperado';
      setMsgType('danger');
      setMsg(`Error al subir: ${errorMsg}`);
    } finally {
      setSubmitting(false);
    }
  };

  const handleCreatePersona = async () => {
    setPersonaSubmitting(true);
    setPersonaError('');
    try {
      const payload = {
        ...personaForm,
      };

      Object.keys(payload).forEach(key => {
        if (payload[key] === '') {
          delete payload[key];
        }
      });

      const response = await createPersona(payload);
      const nuevaPersona = response?.data?.data;

      if (nuevaPersona) {
        setPersonas(prev => [nuevaPersona, ...prev]);
        setSelectedPersona(String(nuevaPersona.id));
        setShowPersonaModal(false);
        setPersonaForm(initialPersonaState);
        setMsgType('success');
        setMsg('Persona creada y seleccionada correctamente.');
      }
    } catch (error) {
      console.error('Error creando persona', error);
      const errorMsg =
        error?.response?.data?.error || error?.message || 'Error inesperado';
      setPersonaError(errorMsg);
    } finally {
      setPersonaSubmitting(false);
    }
  };

  return (
    <Card className="p-3">
      <h5>Nuevo Registro de Secuestro Judicial</h5>

      {msg && (
        <Alert
          className="mb-3"
          variant={msgType === 'success' ? 'success' : 'danger'}
        >
          {msg}
        </Alert>
      )}

      {personasError && <Alert variant="warning">{personasError}</Alert>}

      <Form onSubmit={handleSubmit}>
        <Row className="align-items-end">
          <Col md={8} className="mb-2">
            <Form.Group>
              <Form.Label>Persona asociada</Form.Label>
              <Form.Select
                value={selectedPersona}
                onChange={e => setSelectedPersona(e.target.value)}
                disabled={personasLoading}
              >
                <option value="">Seleccione una persona...</option>
                {personaOptions.map(option => (
                  <option key={option.value} value={option.value}>
                    {option.label}
                    {option.subtitle ? ` - ${option.subtitle}` : ''}
                  </option>
                ))}
              </Form.Select>
            </Form.Group>
          </Col>
          <Col md={4} className="mb-2 d-flex gap-2">
            <Button
              type="button"
              variant="outline-dark"
              className="flex-grow-1"
              onClick={() => setShowPersonaModal(true)}
            >
              Crear persona
            </Button>
            <Button
              type="button"
              variant="outline-secondary"
              onClick={() => {
                setMsg('');
                loadPersonas();
              }}
            >
              {personasLoading ? (
                <Spinner animation="border" size="sm" />
              ) : (
                'Actualizar'
              )}
            </Button>
          </Col>
        </Row>

        <Row>
          <Col md={6}>
            <Form.Group className="mb-2">
              <Form.Label>Fecha de ingreso</Form.Label>
              <Form.Control
                type="date"
                name="fecha_ingreso"
                value={form.fecha_ingreso}
                onChange={handleRegistroChange}
                required
              />
            </Form.Group>
          </Col>
          <Col md={6}>
            <Form.Group className="mb-2">
              <Form.Label>Fecha de carga</Form.Label>
              <Form.Control
                type="date"
                name="fecha_carga"
                value={form.fecha_carga}
                onChange={handleRegistroChange}
              />
            </Form.Group>
          </Col>
        </Row>

        <Form.Group className="mb-2">
          <Form.Label>U.F.I</Form.Label>
          <Form.Control
            name="ufi"
            value={form.ufi}
            onChange={handleRegistroChange}
            placeholder="Ej: UFI"
          />
        </Form.Group>

        <Form.Group className="mb-2">
          <Form.Label>N° Legajo / Causa</Form.Label>
          <Form.Control
            name="numero_legajo"
            value={form.numero_legajo}
            onChange={handleRegistroChange}
            placeholder="Ej: Causa 1234/25"
          />
        </Form.Group>

        <Form.Group className="mb-2">
          <Form.Label>Sección que interviene</Form.Label>
          <Form.Select
            name="seccion_que_interviene"
            value={form.seccion_que_interviene}
            onChange={handleRegistroChange}
            required
          >
            <option value="">Seleccione...</option>
            <option value="Criminalística">Criminalística</option>
            <option value="Robos y Hurtos">Robos y Hurtos</option>
            <option value="Narcotráfico">Narcotráfico</option>
            <option value="Delitos Complejos">Delitos Complejos</option>
            <option value="Otros">Otros</option>
          </Form.Select>
        </Form.Group>

        <Form.Group className="mb-2">
          <Form.Label>Detalle del secuestro</Form.Label>
          <Form.Control
            as="textarea"
            name="detalle_secuestro"
            rows={3}
            value={form.detalle_secuestro}
            onChange={handleRegistroChange}
            placeholder="Describa el secuestro..."
            required
          />
        </Form.Group>

        <Row>
          <Col md={6}>
            <Form.Group className="mb-2">
              <Form.Label>N° de protocolo</Form.Label>
              <Form.Control
                name="numero_protocolo"
                value={form.numero_protocolo}
                onChange={handleRegistroChange}
              />
            </Form.Group>
          </Col>
          <Col md={6}>
            <Form.Group className="mb-2">
              <Form.Label>Cadena de custodia</Form.Label>
              <Form.Control
                name="cadena_custodia"
                value={form.cadena_custodia}
                onChange={handleRegistroChange}
              />
            </Form.Group>
          </Col>
        </Row>

        <Row>
          <Col md={6}>
            <Form.Group className="mb-2">
              <Form.Label>N° de folio</Form.Label>
              <Form.Control
                name="nro_folio"
                value={form.nro_folio}
                onChange={handleRegistroChange}
              />
            </Form.Group>
          </Col>
          <Col md={6}>
            <Form.Group className="mb-2">
              <Form.Label>N° de libro de secuestro</Form.Label>
              <Form.Control
                name="nro_libro_secuestro"
                value={form.nro_libro_secuestro}
                onChange={handleRegistroChange}
              />
            </Form.Group>
          </Col>
        </Row>

        <Form.Group className="mb-2">
          <Form.Label>Of. a cargo de la causa</Form.Label>
          <Form.Control
            name="of_a_cargo"
            value={form.of_a_cargo}
            onChange={handleRegistroChange}
            placeholder="Nombre del oficial"
          />
        </Form.Group>

        <Form.Group className="mb-2">
          <Form.Label>Observaciones</Form.Label>
          <Form.Control
            as="textarea"
            name="observaciones"
            rows={2}
            value={form.observaciones}
            onChange={handleRegistroChange}
          />
        </Form.Group>

        <Form.Group className="mb-3">
          <Form.Label>Archivos adjuntos (PDF, JPG, PNG)</Form.Label>
          <Form.Control
            type="file"
            multiple
            onChange={e => setFiles(e.target.files)}
          />
        </Form.Group>

        <div className="d-flex gap-2">
          <Button variant="dark" type="submit" disabled={submitting}>
            {submitting ? <Spinner animation="border" size="sm" /> : 'GUARDAR'}
          </Button>
          <Button
            variant="outline-secondary"
            type="button"
            onClick={() => {
              resetRegistroForm();
              setMsg('');
            }}
          >
            Limpiar
          </Button>
        </div>
      </Form>

      <Modal
        show={showPersonaModal}
        onHide={() => {
          setShowPersonaModal(false);
          setPersonaError('');
        }}
        centered
      >
        <Modal.Header closeButton>
          <Modal.Title>Nueva persona registrada</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {personaError && <Alert variant="danger">{personaError}</Alert>}
          <Form>
            <Row>
              <Col md={6}>
                <Form.Group className="mb-2">
                  <Form.Label>Nombre *</Form.Label>
                  <Form.Control
                    name="nombre"
                    value={personaForm.nombre}
                    onChange={handlePersonaFieldChange}
                    required
                  />
                </Form.Group>
              </Col>
              <Col md={6}>
                <Form.Group className="mb-2">
                  <Form.Label>Apellido *</Form.Label>
                  <Form.Control
                    name="apellido"
                    value={personaForm.apellido}
                    onChange={handlePersonaFieldChange}
                    required
                  />
                </Form.Group>
              </Col>
            </Row>
            <Form.Group className="mb-2">
              <Form.Label>DNI</Form.Label>
              <Form.Control
                name="dni"
                value={personaForm.dni}
                onChange={handlePersonaFieldChange}
                placeholder="Ej: 30111222"
              />
            </Form.Group>
            <Form.Group className="mb-2">
              <Form.Label>Teléfono</Form.Label>
              <Form.Control
                name="telefono"
                value={personaForm.telefono}
                onChange={handlePersonaFieldChange}
              />
            </Form.Group>
            <Form.Group className="mb-2">
              <Form.Label>Email</Form.Label>
              <Form.Control
                type="email"
                name="email"
                value={personaForm.email}
                onChange={handlePersonaFieldChange}
              />
            </Form.Group>
            <Form.Group className="mb-2">
              <Form.Label>Domicilio</Form.Label>
              <Form.Control
                name="domicilio"
                value={personaForm.domicilio}
                onChange={handlePersonaFieldChange}
              />
            </Form.Group>
          </Form>
        </Modal.Body>
        <Modal.Footer>
          <Button
            variant="secondary"
            onClick={() => {
              setShowPersonaModal(false);
              setPersonaError('');
            }}
            disabled={personaSubmitting}
          >
            Cancelar
          </Button>
          <Button
            variant="dark"
            onClick={handleCreatePersona}
            disabled={
              personaSubmitting || !personaForm.nombre || !personaForm.apellido
            }
          >
            {personaSubmitting ? (
              <Spinner animation="border" size="sm" />
            ) : (
              'Guardar'
            )}
          </Button>
        </Modal.Footer>
      </Modal>
    </Card>
  );
}
